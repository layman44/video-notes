{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VideoNotes",
  "version": "0.1.42",
  "identifier": "com.videonotes.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VideoNotes",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https: http:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/tasks/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/tools/README.md",
      "resources/tools/THIRD_PARTY_NOTICES.md",
      "resources/tools/ffmpeg.exe",
      "resources/tools/ffprobe.exe",
      "resources/tools/media-tools.lock.json",
      "resources/tools/yt-dlp.exe",
      "resources/tools/douyin-cookies.mjs",
      "resources/tools/licenses/*",
      "resources/tools/llama/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
